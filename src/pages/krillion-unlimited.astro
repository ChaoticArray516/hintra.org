---
import BaseLayout from '../layouts/BaseLayout.astro';
import UnlimitedContent from '../components/UnlimitedContent.astro';
import { unlimitedEn } from '../data/pages/krillion-unlimited.en';
import { unlimitedEnFaq } from '../data/faq/krillion-unlimited.en';
import { krillion } from '../data/games/krillion';
import { unlimitedAlternates } from '../data/locales';
import { routes } from '../data/site';
import { buildGraph } from '../lib/schema';

const breadcrumbs = [
  { name: 'Hintra', path: routes.home },
  { name: unlimitedEn.breadcrumbName, path: unlimitedEn.path },
];
const schema = buildGraph({
  path: unlimitedEn.path,
  title: unlimitedEn.title,
  description: unlimitedEn.description,
  inLanguage: unlimitedEn.locale,
  breadcrumbs,
  faq: unlimitedEnFaq,
  aboutGame: {
    name: krillion.name,
    officialSite: krillion.officialSite,
    description: unlimitedEn.aboutDescription,
  },
});
---
<BaseLayout
  title={unlimitedEn.title}
  description={unlimitedEn.description}
  path={unlimitedEn.path}
  locale={unlimitedEn.locale}
  schema={schema}
  alternates={unlimitedAlternates}
>
  <UnlimitedContent page={unlimitedEn} faq={unlimitedEnFaq} />
</BaseLayout>
