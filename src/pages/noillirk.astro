---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import FactCard from '../components/FactCard.astro';
import OfficialLink from '../components/OfficialLink.astro';
import FaqList from '../components/FaqList.astro';
import { noillirkPage } from '../data/pages/noillirk';
import { noillirkFaq } from '../data/faq/noillirk';
import { noillirk } from '../data/games/noillirk';
import { routes } from '../data/site';
import { buildGraph } from '../lib/schema';

const breadcrumbs = [
  { name: 'Hintra', path: routes.home },
  { name: noillirkPage.breadcrumbName, path: noillirkPage.path },
];
const schema = buildGraph({
  path: noillirkPage.path,
  title: noillirkPage.title,
  description: noillirkPage.description,
  inLanguage: noillirkPage.locale,
  breadcrumbs,
  faq: noillirkFaq,
  aboutGame: {
    name: noillirk.name,
    officialSite: noillirk.officialSite,
    description: noillirkPage.aboutDescription,
  },
});
---
<BaseLayout
  title={noillirkPage.title}
  description={noillirkPage.description}
  path={noillirkPage.path}
  locale={noillirkPage.locale}
  schema={schema}
>
  <div class="container reading-page">
    <Breadcrumbs items={breadcrumbs} />
    <header class="page-header">
      <h1>{noillirkPage.h1}</h1>
      <p class="lead" data-copy>{noillirkPage.lead}</p>
    </header>
    <QuoteBlock quotes={[noillirk.statementIndependent, noillirk.statementInspired]} />
    <div class="prose">
      {noillirkPage.sections.map((section) => (
        <section>
          <h2 data-copy>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p data-copy>{paragraph}</p>)}
          {section.heading === 'How a round works' && (
            <FactCard items={[
              { label: 'ROUND', value: `${noillirk.questionCount} questions` },
              { label: 'TIMER', value: `${noillirk.secondsPerQuestion} seconds` },
              { label: 'BOARD', value: noillirk.perQuestionBoard },
              { label: 'SCORING', value: noillirk.goal },
            ]} />
          )}
          {section.heading === 'How Noillirk differs from Krillion' && (
            <FactCard class="comparison" items={[
              { label: 'NOILLIRK', value: 'More common answers score higher' },
              { label: 'KRILLION', value: 'Rarer answers score higher' },
            ]} />
          )}
          {section.heading === 'Where the official entry is' && (
            <OfficialLink href={noillirk.officialSite} label={noillirkPage.officialLabel} title={section.heading} />
          )}
        </section>
      ))}
    </div>
    <FaqList items={noillirkFaq} />
  </div>
</BaseLayout>
