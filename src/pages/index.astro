---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homePage } from '../data/pages/home';
import { buildGraph } from '../lib/schema';
import { route } from '../lib/url';

const schema = buildGraph({
  path: homePage.path,
  title: homePage.title,
  description: homePage.description,
  inLanguage: homePage.locale,
  isHome: true,
});
---
<BaseLayout
  title={homePage.title}
  description={homePage.description}
  path={homePage.path}
  locale={homePage.locale}
  schema={schema}
>
  <div class="container">
    <section class="home-hero">
      <div>
        <h1>{homePage.h1}</h1>
        <p class="lead" data-copy>{homePage.lead}</p>
      </div>
      <div class="brand-panel" aria-hidden="true">
        <svg width="128" height="128" viewBox="0 0 512 512" focusable="false">
          <rect x="112" y="96" width="72" height="320" rx="36" fill="#1E2733" />
          <rect x="328" y="96" width="72" height="320" rx="36" fill="#1E2733" />
          <path d="M184 256 H228 M244 256 H268 M284 256 H328" fill="none" stroke="#1E2733" stroke-width="44" stroke-linecap="round" />
          <path d="M184 256 H228 M244 256 H268 M284 256 H328" fill="none" stroke="#B96A22" stroke-width="18" stroke-linecap="round" stroke-dasharray="30 16" />
          <circle cx="256" cy="256" r="10" fill="#B96A22" />
        </svg>
      </div>
    </section>
    <section class="home-entries">
      <h2 data-copy>{homePage.entriesHeading}</h2>
      <div class="entry-grid">
        {homePage.entries.map((entry) => (
          <article class="entry-card">
            <h3><a href={route(entry.path)} data-copy>{entry.title}</a></h3>
            <p data-copy>{entry.description}</p>
          </article>
        ))}
      </div>
      <p data-copy>{homePage.entriesFollowup}</p>
    </section>
    <section class="home-contents">
      <h2 data-copy>{homePage.contentsHeading}</h2>
      <p data-copy>{homePage.contents}</p>
    </section>
  </div>
</BaseLayout>
