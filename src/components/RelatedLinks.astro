---
import { route } from '../lib/url';

interface Props {
  items: { title: string; description: string; path: string }[];
}

const { items } = Astro.props;
---
<aside class="related-links">
  <h2>Related entries</h2>
  <ul>
    {items.map((item) => (
      <li>
        <a href={route(item.path)}>{item.title}</a>
        <p>{item.description}</p>
      </li>
    ))}
  </ul>
</aside>
